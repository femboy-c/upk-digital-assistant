# development — демо-запуск, production — реальный сайт.
# В production приложение не запустится с демонстрационным SECRET_KEY,
# а демо-пользователи staff/admin не создаются автоматически.
APP_ENV=development

# Секретный ключ для подписи cookie-сессии.
# В демо можно оставить как есть; на реальном сервере — заменить на длинную случайную строку.
SECRET_KEY=dev-secret-поменяйте-в-проде

# Адрес, который зашивается в QR-коды. Для проверки со смартфона укажите
# сетевой адрес компьютера (телефон должен быть в той же Wi-Fi-сети):
# PUBLIC_BASE_URL=http://192.168.1.50:8000
# Для реального запуска:
# PUBLIC_BASE_URL=https://upk.example.ru
PUBLIC_BASE_URL=

# Включать только на реальном HTTPS-сайте: cookie сессии будет передаваться
# исключительно по HTTPS.
# SESSION_HTTPS_ONLY=1

# Доверять заголовку X-Forwarded-For. Включать только за Caddy/nginx,
# иначе клиент сможет подделать IP и обойти ограничение частоты запросов.
# При прямом доступе к uvicorn оставьте 0.
# TRUST_PROXY=1

# Общий лимит хранилища вложений (в мегабайтах).
MAX_UPLOAD_TOTAL_MB=200

# Максимальный размер всего HTTP-запроса (форма + фотография).
MAX_REQUEST_BODY_MB=12

# Сколько дней действует ссылка отслеживания заявки. 0 — бессрочно.
TRACKING_LINK_TTL_DAYS=90

# Ключ для внешнего ИИ (в демо-версии не используется).
# OPENAI_API_KEY=
